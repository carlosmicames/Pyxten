# =============================================================================
# PYXTEN ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your values
# =============================================================================

# Anthropic API (for PCOC validation)
ANTHROPIC_API_KEY=your_api_key_here

# OpenAI API (for chatbot and project interpretation)
OPENAI_API_KEY=your_openai_api_key_here

# Google Maps API (for address validation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# =============================================================================
# SUPABASE (REQUIRED for multi-user persistence)
# =============================================================================
# Get these from your Supabase project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# =============================================================================
# STREAMLIT CLOUD SECRETS
# =============================================================================
# When deploying to Streamlit Cloud, add these as secrets in the dashboard:
#
# 1. Go to your app on Streamlit Cloud
# 2. Click "Settings" > "Secrets"
# 3. Add the following (TOML format):
#
# SUPABASE_URL = "https://your-project.supabase.co"
# SUPABASE_KEY = "your_supabase_anon_key_here"
# ANTHROPIC_API_KEY = "your_api_key_here"
# OPENAI_API_KEY = "your_openai_api_key_here"
# GOOGLE_MAPS_API_KEY = "your_google_maps_api_key_here"
#
# =============================================================================
