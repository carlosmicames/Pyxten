# Anthropic API (for PCOC validation)
ANTHROPIC_API_KEY=your_api_key_here

# OpenAI API (for chatbot and project interpretation)
OPENAI_API_KEY=your_openai_api_key_here

# Google Maps API (for address validation)
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase (for database persistence and authentication)
# Optional - app will work with session-only storage if not configured
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here