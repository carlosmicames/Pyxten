# Database (Supabase Postgres connection string)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Supabase
SUPABASE_URL=https://[PROJECT_REF].supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-settings
# Anon key. Required by the reviewer console: it reaches Postgres through
# PostgREST as the signed-in user so Row Level Security enforces org isolation.
SUPABASE_ANON_KEY=your-anon-public-key

# External APIs
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
# Applicant flow only (use classifier + asistente IA)
OPENAI_API_KEY=your-openai-api-key
# Reviewer console only. Document classification runs on Anthropic; the two
# paths never share a provider.
ANTHROPIC_API_KEY=your-anthropic-api-key
# Optional override; defaults to claude-opus-5
REVIEWER_MODEL=claude-opus-5

# CORS (production domains - include both www and non-www)
CORS_ALLOWED_ORIGINS=https://pyxten.com,https://www.pyxten.com,http://localhost:3000,http://localhost:3001

# App
DEBUG=false
APP_URL=https://pyxten.com

# Admin emails (comma-separated) - bypass subscription checks
ADMIN_EMAILS=cj.micames@gmail.com,info@pyxten.com

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_PROFESSIONAL_MONTHLY=price_...
STRIPE_PRICE_PROFESSIONAL_ANNUAL=price_...
STRIPE_PRICE_EMPRESARIAL_MONTHLY=price_...
STRIPE_PRICE_EMPRESARIAL_ANNUAL=price_...
